# PII / proofs / audit
PRESIDIO_URL=http://localhost:5001
PRESIDIO_SERVICE_TOKEN=
PRESIDIO_MODE=REDUCED_PII_MODE
DATA_KEK_BASE64=
AUDIT_SIGNING_PRIVATE_KEY_BASE64=
AUDIT_SIGNING_PUBLIC_KEY_BASE64=

# Jobs and limits
PG_BOSS_SCHEMA=pgboss
WORKER_ENABLED=true
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=40
AI_PROVIDER_TIMEOUT_MS=45000

# Kite testnet (no API key; passkey session)
KITE_ENABLED=false
KITE_PASSPORT_API=https://agentpassport.ai/api
KITE_TEST_X402_ENDPOINT=https://passport.dev.gokite.ai/x402/test
KITE_TESTNET_ASSET=PIEUSD
KITE_SESSION_ID=
KITE_MAX_PER_PAYMENT_MINOR=500
KITE_MAX_TOTAL_MINOR=2000
KITE_SESSION_EXPIRY=

# Optional integrations
REPPO_API_KEY=
