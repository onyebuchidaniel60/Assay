# Assay environment — placeholders only. Never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database / auth / private storage (Phase 2 — Neon is the sole data layer)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_API_KEY=
NEON_AUTH_COOKIE_SECRET=
NEON_STORAGE_BUCKET=assay-private-documents
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Layer 2 confidential extraction
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=
NEARAI_ATTESTATION_REQUIRED=true

# General inference
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_JUDGEMENT=
OPENROUTER_MODEL_GENERATION=

# SERV orchestration
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_REASONING_API_KEY=
SERV_MODEL=serv-standard

# PII / proofs / audit
PRESIDIO_URL=http://localhost:5001
PRESIDIO_SERVICE_TOKEN=
PRESIDIO_MODE=REDUCED_PII_MODE
DATA_KEK_BASE64=
AUDIT_SIGNING_PRIVATE_KEY_BASE64=
AUDIT_SIGNING_PUBLIC_KEY_BASE64=

# Jobs
WORKER_ENABLED=true

# Arc payments (server-side only; never NEXT_PUBLIC)
# ARC_SETTLEMENT_MODEL: circle-gateway for Arc Testnet, x402-exact for Arc Mainnet.
ARC_PAYMENTS_ENABLED=false
PAYMENT_EXECUTION_ENABLED=false
PAYMENT_DRY_RUN=true
ARC_NETWORK=eip155:5042002
ARC_SETTLEMENT_MODEL=circle-gateway
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_PRIVATE_KEY=
ARC_MAINNET_PRIVATE_KEY=
ARC_TESTNET_PAYER_ADDRESS=
ARC_MAINNET_PAYER_ADDRESS=
CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
CIRCLE_GATEWAY_MAINNET_FACILITATOR_URL=https://gateway-api.circle.com
PAYMENT_SESSION_ID=assay-arc-testnet-session-1
PAYMENT_SESSION_EXPIRES_AT=
PAYMENT_MAX_PER_TX_MINOR=100000
PAYMENT_MAX_TOTAL_MINOR=500000
PAYMENT_ALLOWED_PROVIDERS=
PAYMENT_ALLOWED_ENDPOINTS=
PAYMENT_ALLOWED_RECIPIENTS=
PAYMENT_ALLOWED_NETWORKS=eip155:5042002
PAYMENT_ALLOWED_ASSETS=0x3600000000000000000000000000000000000000
PAYMENT_REQUEST_TIMEOUT_MS=20000
PAYMENT_RECONCILE_INTERVAL_SECONDS=60
PAYMENT_RECONCILE_MAX_ATTEMPTS=10

# Financial data (free SEC EDGAR + optional paid providers)
SEC_EDGAR_USER_AGENT=Assay/0.1 (set a real operator contact; required by SEC fair access)
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai
LONESTAR_ORACLE_BASE_URL=https://equity.lonestaroracle.xyz

# Optional integrations
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
REPPO_ENABLED=true
GOOGLE_GENAI_API_KEY=
ENABLE_DEMO_SHRED=false
